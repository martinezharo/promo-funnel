{
  "name": "@martinezharo/promo-funnel",
  "version": "1.0.1",
  "description": "What a visitor who followed a promo from one of the author's sites did next: the shared contract, page tracker and Worker handler.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.10.0",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./page": { "types": "./dist/page.d.ts", "default": "./dist/page.js" },
    "./worker": { "types": "./dist/worker.d.ts", "default": "./dist/worker.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm check && pnpm test && pnpm build && git diff --exit-code -- dist"
  },
  "devDependencies": {
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
